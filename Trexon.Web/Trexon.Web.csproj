<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Version>1.0.0-dev</Version>
    <PackageId>Trexon.Web</PackageId>
    <Title>Trexon.Web</Title>
    <Authors>Trexoncorp</Authors>
    <Description>Attribute-first HTTP APIs with modules, validation, authentication and automatic OpenAPI documentation.</Description>
    <PackageTags>web;api;aspnetcore;openapi;modules</PackageTags>
    <PackageProjectUrl>https://github.com/Trexoncorp/Trexon.Web</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Trexoncorp/Trexon.Web</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Internal/SwaggerLogin.js" />
    <EmbeddedResource Include="Internal/WebSocketConsole.html" />
    <EmbeddedResource Include="Internal/WebSocketConsole.js" />
    <None Include="../README*.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
